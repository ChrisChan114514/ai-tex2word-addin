<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="AITeX_RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="AITeX_Tab" label="AI 公式" insertAfterMso="TabInsert">
        <group id="AITeX_GroupConvert" label="TeX 转 Word 公式">
          <button id="AITeX_ConvertSelection"
                  label="转换选中内容"
                  size="large"
                  imageMso="EquationInsertNew"
                  screentip="转换选中的 AI TeX（Ctrl+Alt+Shift+E）"
                  supertip="识别选区内的 \(...\) 和 \[...\]，转换为可编辑的 Word 原生公式。快捷键仅在未被其他命令占用时启用。"
                  onAction="AITeX_RibbonConvertSelection"/>
          <button id="AITeX_ConvertDocument"
                  label="转换全文"
                  size="large"
                  imageMso="EquationProfessional"
                  screentip="转换正文中的 AI TeX"
                  supertip="扫描正文全文，将 \(...\) 转为行内公式，将 \[...\] 转为独立公式。"
                  onAction="AITeX_RibbonConvertDocument"/>
          <button id="AITeX_ConversionErrors"
                  label="转换错误详情"
                  imageMso="ReviewShowMarkupMenu"
                  screentip="查看本次未转换公式的原因"
                  onAction="AITeX_ShowLastReport"/>
        </group>
        <group id="AITeX_GroupFormat" label="公式整理">
          <button id="AITeX_RemoveBoxes"
                  label="去除公式方框"
                  size="large"
                  imageMso="BorderNone"
                  screentip="一键去除全文公式的 box 外框"
                  supertip="移除文档中 Word 原生公式的方框（包括嵌套方框），保留内部公式内容与结构。支持 Ctrl+Z 一次撤销。尚未转换的 TeX 请先点击转换全文。"
                  onAction="AITeX_RibbonRemoveBoxes"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
